# Copy to .env and fill in your own values. Never commit .env.
# NASA API key (free): https://api.nasa.gov  — DEMO_KEY works but is rate-limited
NASA_API_KEY=DEMO_KEY

# Optional: Supabase cache for NASA responses (safe to leave blank; the app then
# calls NASA directly and labels anything it had to fall back on as DEMO DATA)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: override the app's default cache TTL in seconds
NASA_CACHE_TTL=3600
